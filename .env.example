# Copy this file to ".env" in the same directory as docker-compose.yml and fill
# in real values. ".env" is gitignored — it will never be committed, and it
# persists across "git pull" + rebuilds since git never touches ignored files.
#
# Generate a strong secret with (run this ON the target server, not on a shared
# machine, so the real value never ends up in shell history you don't control):
#   openssl rand -base64 64
#
# Docker Compose automatically loads a ".env" file sitting next to
# docker-compose.yml — no extra flags needed, `docker compose up -d` picks it
# up on its own.

JWT_SECRET=
