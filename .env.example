# Copy this file to ".env" in the same directory as docker-compose.yml and fill
# in real values. ".env" is gitignored — it will never be committed, and it
# persists across "git pull" + rebuilds since git never touches ignored files.
#
# Generate a strong secret with (run this ON the target server, not on a shared
# machine, so the real value never ends up in shell history you don't control):
#   openssl rand -base64 64
#
# Docker Compose automatically loads a ".env" file sitting next to
# docker-compose.yml — no extra flags needed, `docker compose up -d` picks it
# up on its own.

JWT_SECRET=

# Optional — used to build email-verification / password-reset links. Defaults to
# https://dourak.money (docker-compose.yml) if left unset.
# FRONTEND_BASE_URL=https://dourak.money

# Optional — SMTP credentials for a real mail provider (e.g. Zoho Mail, Resend SMTP).
# Left empty, verification/reset emails are logged instead of sent (see
# LoggingEmailSender in Dourak.Infrastructure) — safe default, nothing breaks, but
# nobody actually receives the email until these are filled in.
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USER=no-reply@dourak.money
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=no-reply@dourak.money

# Optional — the admin site (admin.dourak.money) login. Left empty, no admin account is
# seeded and the site has no way to be logged into. Set both to create/promote this account
# on the next startup (idempotent — safe to leave set permanently).
# ADMIN_EMAIL=admin@dourak.money
# ADMIN_PASSWORD=
