# Domain is live (dourak.money, registered via Namecheap) — Caddy automatically
# requests and renews a free Let's Encrypt certificate for it via ACME HTTP-01
# challenge (needs port 80 reachable from the internet for the initial challenge,
# then serves everything over HTTPS on port 443; HTTP requests are auto-redirected
# to HTTPS). Requires the domain's DNS A record to point at this server's public IP
# before the container starts, or the ACME challenge fails and Caddy falls back to
# retrying in the background.
dourak.money, www.dourak.money {
	# API calls stay same-origin from the browser's point of view — Caddy
	# forwards them to the api container, path unchanged (e.g. /api/circles
	# arrives at the API as /api/circles, matching its [Route("api/...")]).
	handle /api/* {
		reverse_proxy api:8080
	}

	# Everything else is the React SPA. try_files falls back to index.html
	# so client-side routes (e.g. /circles/5) don't 404 on a hard refresh.
	handle {
		root * /srv
		encode gzip
		try_files {path} /index.html
		file_server
	}
}
