# Domain is live (dourak.money, registered via Namecheap) — Caddy automatically
# requests and renews a free Let's Encrypt certificate for it via ACME HTTP-01
# challenge (needs port 80 reachable from the internet for the initial challenge,
# then serves everything over HTTPS on port 443; HTTP requests are auto-redirected
# to HTTPS). Requires the domain's DNS A record to point at this server's public IP
# before the container starts, or the ACME challenge fails and Caddy falls back to
# retrying in the background.
# Admin site (separate codebase — see admin/) — Caddy automatically requests its own
# Let's Encrypt cert for this hostname too, independent of the main site's. Proxied to the
# admin-web container (internal-only, not published on the host) rather than serving it
# from this container directly, so the two codebases/builds stay fully separate while both
# still go through this single public HTTPS entrypoint.
admin.dourak.money {
	reverse_proxy admin-web:80
}

# Seq (structured logs) and Adminer (DB GUI), publicly exposed for convenience — NO auth in
# front of either at the request of the project owner. Adminer in particular is full
# read/write access to the database once someone has this URL; there is nothing else standing
# between the internet and it. Revisit adding Caddy `basic_auth` here if that ever changes.
logs.dourak.money {
	reverse_proxy seq:80
}

db.dourak.money {
	reverse_proxy adminer:8080
}

dourak.money, www.dourak.money {
	# API calls stay same-origin from the browser's point of view — Caddy
	# forwards them to the api container, path unchanged (e.g. /api/circles
	# arrives at the API as /api/circles, matching its [Route("api/...")]).
	handle /api/* {
		reverse_proxy api:8080
	}

	# OAuth discovery documents (RFC 8414 / RFC 9728) for the MCP server's authorization-code
	# flow (see Dourak.Api/Controllers/OAuthController.cs) — these two exact paths only, so the
	# rest of /.well-known/ (e.g. assetlinks.json for Android App Links) still falls through to
	# the SPA's static file_server below.
	handle /.well-known/oauth-authorization-server {
		reverse_proxy api:8080
	}
	handle /.well-known/oauth-protected-resource {
		reverse_proxy api:8080
	}

	# Everything else is the React SPA. try_files falls back to index.html
	# so client-side routes (e.g. /circles/5) don't 404 on a hard refresh.
	handle {
		root * /srv
		encode gzip
		try_files {path} /index.html
		file_server
	}
}

# Sibling project on this same server: DAQN (barbershop booking), https://daqn.hair.
# Dourak's Caddy owns ports 80/443, so it terminates TLS (own Let's Encrypt cert) for daqn.hair
# and proxies to DAQN's `daqn-web` container, which joins this compose project's default network
# (dourak-money_default) from DAQN's own compose file (/home/ubuntu/daqn/deploy). DAQN is
# deployed separately (scripts/deploy-prod.sh in the DAQN repo); if it is down this block just
# returns 502 and Dourak's own sites are unaffected.
daqn.hair, www.daqn.hair {
	encode gzip

	# Behind Cloudflare (orange cloud) the TCP peer is a Cloudflare edge, so hand DAQN the real
	# visitor address (its rate limiting is per client IP). Direct (grey cloud) requests fall through.
	@cf header Cf-Connecting-Ip *
	handle @cf {
		reverse_proxy daqn-web:80 {
			header_up X-Forwarded-For {header.Cf-Connecting-Ip}
		}
	}
	handle {
		reverse_proxy daqn-web:80
	}
}
