<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8.0+, API 26+) — lets the launcher mask/animate the icon
     (circle, squircle, rounded square, etc. depending on the device's launcher) instead
     of always cropping to a fixed square, unlike the flat mipmap-*/ic_launcher.png files
     (kept as the fallback for pre-API-26 devices). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
